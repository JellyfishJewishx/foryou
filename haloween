task.spawn(function()
    SetStatus("Looking for dungeon...", 0.05)
    graveyard = workspace:WaitForChild("Reaper's Graveyard", 15)
    if not graveyard then
        SetStatus("Reaper's Graveyard not found. Enter the dungeon first.", 0)
        return
    end
    slots = graveyard:WaitForChild("PuzzleSlots", 10)
    if not slots then
        SetStatus("PuzzleSlots not found", 0)
        return
    end

    -- เปิดโจมตีอัตโนมัติ
    getgenv().autoClick = true
    btnClick.Text = "Attack: ON"
    startClick()

    SetStatus("Solving puzzle", 0.1)
    if not Collection:Getevent() then return end

    SetStatus("Farming Necromancer", 0.4)
    if not Collection:autoclerraid() then return end

    SetStatus("Entering portal", 0.6)
    if Collection:teleportHaun() then
        task.wait(2)

        SetStatus("Boss 1: Haunted Reaper", 0.8)
        Collection:farmBoss("Haunted Reaper", 30)

        SetStatus("Boss 2: Walter Wraith", 0.95)
        Collection:farmBoss("Walter Wraith", 30)

        SetStatus("Done", 1)
    else
        SetStatus("Portal teleport failed", 0.6)
    end
end)
