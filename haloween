----------------------------------------------------------------
-- ฟังก์ชันช่วย
----------------------------------------------------------------
local function getRoot()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function tp(cf)
    local r = getRoot()
    if r then r.CFrame = cf end
end

----------------------------------------------------------------
-- ตัวโจมตีอัตโนมัติ (กดปุ่มบนจอ)
----------------------------------------------------------------
local attackBtn
local attackFound = false

local function findAttackButton()
    for _, v in ipairs(pg:GetDescendants()) do
        if (v:IsA("TextButton") or v:IsA("ImageButton")) and v.Visible then
            local t = (v:IsA("TextButton") and v.Text or "") .. " " .. v.Name
            local lt = t:lower()
            if t:find("หมัด") or lt:find("m1") or lt:find("punch") or lt:find("attack") then
                -- ข้ามปุ่มของ UI ตัวเอง
                if not v:FindFirstAncestor("WhipperX_UI") then
                    return v
                end
            end
        end
    end
end

local function doClick()
    pcall(function()
        -- 1) ถ้าถืออาวุธ ให้สั่งใช้ด้วย
        local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
        if tool then tool:Activate() end

        -- 2) หาปุ่มโจมตีบนจอ
        if not attackBtn or not attackBtn.Parent or not attackBtn.Visible then
            attackBtn = findAttackButton()
        end
        attackFound = attackBtn ~= nil
        if not attackBtn then return end

        -- 3) ลองสั่ง event ของปุ่มตรง ๆ ก่อน
        local fired = false
        if getconnections then
            for _, sig in ipairs({ "MouseButton1Down", "MouseButton1Click", "Activated", "TouchTap" }) do
                pcall(function()
                    for _, c in ipairs(getconnections(attackBtn[sig])) do
                        c:Fire()
                        fired = true
                    end
                end)
            end
        end

        -- 4) ไม่ได้ผล ให้จำลองการแตะที่ตำแหน่งปุ่ม
        if not fired then
            local inset = GuiService:GetGuiInset()
            local p = attackBtn.AbsolutePosition + attackBtn.AbsoluteSize / 2 + inset
            VIM:SendMouseButtonEvent(p.X, p.Y, 0, true, game, 1)
            task.wait(0.03)
            VIM:SendMouseButtonEvent(p.X, p.Y, 0, false, game, 1)
        end
    end)
end

local clickRunning = false
local function startClick()
    if clickRunning then return end
    clickRunning = true
    task.spawn(function()
        while getgenv().autoClick do
            doClick()
            task.wait(0.15)
        end
        clickRunning = false
    end)
end

