----------------------------------------------------------------
-- ฟาร์ม
----------------------------------------------------------------
local Collection = {}
local graveyard, slots

-- 1) แก้ปริศนา
function Collection:Getevent()
    local order = {}
    for i = 1, 5 do
        local slot = slots:FindFirstChild(tostring(i))
        local shape = slot and slot:GetChildren()[1]
        if shape then
            order[i] = shape.Name
        end
    end

    print("Order:", table.concat(order, " -> "))

    for i, name in ipairs(order) do
        if not getgenv().auto then return false end
        local target = graveyard:FindFirstChild(name)

        if target and getRoot() then
            tp(target.CFrame)
            task.wait(0.4)
            local prompt = target:FindFirstChild("ProximityPrompt")
            if prompt then
                pcall(fireproximityprompt, prompt)
            end
            task.wait(0.6)
        else
            warn("Not found: " .. tostring(name) .. " (slot " .. i .. ")")
        end
    end
    return true
end

-- 2) ฆ่า Necromancer จนหมด
function Collection:autoclerraid()
    while getgenv().auto do
        task.wait()
        local found = false

        for _, Mon in pairs(workspace:GetChildren()) do
            if Mon.Name == "Necromancer"
                and Mon:FindFirstChild("Humanoid")
                and Mon:FindFirstChild("HumanoidRootPart")
                and Mon.Humanoid.Health > 0 then
                found = true
                pcall(function()
                    repeat
                        task.wait()
                        tp(Mon.HumanoidRootPart.CFrame * CFrame.new(0, 0, 8))
                    until Mon.Humanoid.Health <= 0 or not Mon.Parent or not getgenv().auto
                end)
            end
        end

        if not found then
            return true
        end
    end
    return false
end

-- 3) วาปเข้า Portal
function Collection:teleportHaun()
    local ok = pcall(function()
        local portal = graveyard.Portal
        tp(portal.CFrame)
        task.wait(0.6)
        fireproximityprompt(portal.Attachment.ProximityPrompt)
    end)
    return ok
end

-- 4) ฟาร์มบอส (รอให้เกิดก่อน)
function Collection:farmBoss(name, waitTime)
    local boss
    local t = 0

    while getgenv().auto and t < (waitTime or 30) do
        for _, v in ipairs(workspace:GetDescendants()) do
            if v.Name == name
                and v:FindFirstChild("Humanoid")
                and v:FindFirstChild("HumanoidRootPart")
                and v.Humanoid.Health > 0 then
                boss = v
                break
            end
        end
        if boss then break end
        task.wait(0.5)
        t = t + 0.5
    end

    if not boss then
        warn("Boss not found: " .. name)
        return false
    end

    print("Found boss:", boss:GetFullName())
    pcall(function()
        repeat
            task.wait()
            tp(boss.HumanoidRootPart.CFrame * CFrame.new(0, 0, 8))
        until boss.Humanoid.Health <= 0 or not boss.Parent or not getgenv().auto
    end)
    return true
end

