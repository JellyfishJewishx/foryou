local function stroke(obj, thick, color)
    local s = Instance.new("UIStroke")
    s.Color = color or WHITE
    s.Thickness = thick or 2
    s.Parent = obj
end

local function styleText(obj)
    obj.TextStrokeTransparency = 0.3
